{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "log",
        "report",
        "patch",
        "source",
        "test_result",
        "evidence",
        "other"
      ],
      "title": "ArtifactKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ArtifactKind"
    },
    "media_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Media Type"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sha256_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sha256 Digest"
    },
    "size_bytes": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Size Bytes"
    },
    "uri": {
      "description": "Opaque, provider-neutral artifact reference",
      "minLength": 1,
      "title": "Uri",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "kind",
    "uri",
    "created_at"
  ],
  "title": "Artifact",
  "type": "object"
}
