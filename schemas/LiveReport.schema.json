{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "media_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256 Digest"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "uri": {
          "description": "Opaque, provider-neutral artifact reference",
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "artifact_id",
        "kind",
        "uri",
        "created_at"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "ArtifactKind": {
      "enum": [
        "log",
        "report",
        "patch",
        "source",
        "test_result",
        "evidence",
        "other"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "max_cost_units": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Units"
        },
        "max_duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Max Duration Seconds",
          "type": "integer"
        },
        "max_executor_calls": {
          "exclusiveMinimum": 0,
          "title": "Max Executor Calls",
          "type": "integer"
        },
        "max_repair_iterations": {
          "minimum": 0,
          "title": "Max Repair Iterations",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "max_duration_seconds",
        "max_executor_calls",
        "max_repair_iterations"
      ],
      "title": "Budget",
      "type": "object"
    },
    "BudgetUsage": {
      "additionalProperties": false,
      "properties": {
        "cost_units": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Units"
        },
        "duration_seconds": {
          "minimum": 0,
          "title": "Duration Seconds",
          "type": "integer"
        },
        "executor_calls": {
          "minimum": 0,
          "title": "Executor Calls",
          "type": "integer"
        },
        "repair_iterations": {
          "minimum": 0,
          "title": "Repair Iterations",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "duration_seconds",
        "executor_calls",
        "repair_iterations"
      ],
      "title": "BudgetUsage",
      "type": "object"
    },
    "ContractRef": {
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "minLength": 1,
          "title": "Contract Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "contract_id",
        "revision"
      ],
      "title": "ContractRef",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "draft",
        "awaiting_confirmation",
        "running",
        "pause_requested",
        "quiescing",
        "paused",
        "delivery_ready",
        "succeeded",
        "failed",
        "error",
        "interrupted",
        "cancelled",
        "rejected"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "UnverifiedItem": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "impact": {
          "minLength": 1,
          "title": "Impact",
          "type": "string"
        },
        "item_id": {
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "item_id",
        "description",
        "reason",
        "impact"
      ],
      "title": "UnverifiedItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "budget_usage": {
      "$ref": "#/$defs/BudgetUsage"
    },
    "completed_node_ids": {
      "items": {
        "type": "string"
      },
      "title": "Completed Node Ids",
      "type": "array"
    },
    "contract": {
      "$ref": "#/$defs/ContractRef"
    },
    "current_node_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Node Id"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "progress_summary": {
      "minLength": 1,
      "title": "Progress Summary",
      "type": "string"
    },
    "report_id": {
      "minLength": 1,
      "title": "Report Id",
      "type": "string"
    },
    "risks": {
      "items": {
        "type": "string"
      },
      "title": "Risks",
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "run_status": {
      "$ref": "#/$defs/RunStatus"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "unverified_items": {
      "items": {
        "$ref": "#/$defs/UnverifiedItem"
      },
      "title": "Unverified Items",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "report_id",
    "run_id",
    "contract",
    "generated_at",
    "run_status",
    "progress_summary",
    "budget",
    "budget_usage"
  ],
  "title": "LiveReport",
  "type": "object"
}
